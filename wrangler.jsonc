{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fbads-alf-dashboard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "CONFIG",
      "id": "35cc3d04a5504dbfbb61ec5b7fe3a0c1"
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://aixjkcqupoysdiqcopke.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_qNMn7TMVQbbbr4Tema8mvA_CsrXEWQO",
    "META_APP_ID": "2102734267288241"
  },
  "triggers": {
    "crons": ["*/10 * * * *", "0 16 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
